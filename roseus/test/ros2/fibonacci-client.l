;; action client of example_interfaces/Fibonacci
(ros::roseus-add-actions "example_interfaces")
(ros::roseus "fibonacci_client")
(setq c (instance ros::simple-action-client :init "fibonacci" example_interfaces::FibonacciAction))
(unless (send c :wait-for-server 30) (exit 2))
(setq *feedbacks* 0)
(setq goal (instance example_interfaces::FibonacciGoal :init :order 5))
(send c :send-goal goal :feedback-cb #'(lambda (fb) (incf *feedbacks*)))
(unless (send c :wait-for-result :timeout 30) (exit 3))
(format t "result ~A state ~A feedbacks ~A~%" (send (send c :get-result) :sequence) (send c :get-state) *feedbacks*)
(unless (equal (coerce (send (send c :get-result) :sequence) cons) '(0 1 1 2 3 5)) (exit 4))
(unless (> *feedbacks* 0) (exit 5))
;; cancel
(send c :send-goal (instance example_interfaces::FibonacciGoal :init :order 100))
(ros::duration-sleep 0.5) (send c :spin-once)
(send c :cancel-goal)
(send c :wait-for-result :timeout 30)
(format t "canceled state ~A~%" (send c :get-state))
(exit (if (= (send c :get-state) actionlib_msgs::GoalStatus::*preempted*) 0 6))
