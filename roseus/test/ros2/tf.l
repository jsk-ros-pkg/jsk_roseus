;; tf on ROS 2: broadcast /eus_base -> /eus_child, and lookup world -> rclpy_frame
(ros::roseus "tf_test")
(setq b (instance ros::transform-broadcaster :init))
(setq l (instance ros::transform-listener :init))
(setq start (ros::time-now) found nil)
(ros::rate 20)
(setq found-time nil)
(while (and (ros::ok) (< (send (ros::time- (ros::time-now) start) :to-sec) 30)
            (not (and found-time (> (send (ros::time- (ros::time-now) found-time) :to-sec) 2))))
  (send b :send-transform (make-coords :pos #f(100 200 300) :rpy (float-vector pi/2 0 0)) "eus_base" "eus_child")
  (when (and (not found) (send l :wait-for-transform "world" "rclpy_frame" (ros::time 0) 0.1))
    (setq c (send l :lookup-transform "world" "rclpy_frame" (ros::time 0)))
    (format t "~%LOOKUP ~A~%" (send c :worldpos))
    (setq found (eps-v= (send c :worldpos) #f(1000 -2000 500)))
    (if found (setq found-time (ros::time-now))))
  (ros::spin-once)
  (ros::sleep))
(exit (if found 0 1))
