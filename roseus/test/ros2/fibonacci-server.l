;; action server of example_interfaces/Fibonacci, as the ROS 1 roseus
(ros::roseus-add-actions "example_interfaces")
(ros::roseus "fibonacci_server")
(defun fibonacci-execute-cb (server goal)
  (let ((order (send goal :goal :order)) (seq (list 1 0)) fb)
    (dotimes (i (1- order))
      (when (send server :is-preempt-requested)
        (send server :set-preempted)
        (return-from fibonacci-execute-cb nil))
      (push (+ (car seq) (cadr seq)) seq)
      (send server :publish-feedback (send server :feedback :sequence (coerce (reverse seq) integer-vector)))
      (ros::duration-sleep 0.1)
      (send server :spin-once))
    (send server :set-succeeded (send server :result :sequence (coerce (reverse seq) integer-vector)))))
(setq s (instance ros::simple-action-server :init "fibonacci" example_interfaces::FibonacciAction
                  :execute-cb 'fibonacci-execute-cb))
(ros::rate 50)
(setq start (ros::time-now))
(while (and (ros::ok) (< (send (ros::time- (ros::time-now) start) :to-sec) 60))
  (send s :worker)
  (ros::spin-once)
  (ros::sleep))
(exit 0)
