;; read "TYPE HEX" lines from stdin, deserialize, serialize again, print HEX
;; TYPE is pkg/msg/Name
(lisp::install-error-handler
 #'(lambda (code msg1 form &optional msg2)
     (format *error-output* "ERROR ~A ~A ~A~%" msg1 form msg2) (exit 1)))
(ros::roseus "cdr_roundtrip")
(defun hex->string (h)
  (let ((s (make-string (/ (length h) 2))))
    (dotimes (i (length s)) (setf (elt s i) (read-from-string (format nil "#x~A" (subseq h (* 2 i) (+ 2 (* 2 i)))))))
    s))
(defun string->hex (s)
  (apply #'concatenate string (map cons #'(lambda (c) (format nil "~0,2x" c)) s)))
(let (line)
  (while (setq line (read-line *standard-input* nil nil))
    (let* ((sp (position #\Space line))
           (type (subseq line 0 sp))
           (hex (subseq line (1+ sp)))
           (pkg (subseq type 0 (position #\/ type)))
           (name (subseq type (1+ (position #\/ type :start (1+ (position #\/ type))))))
           cls msg)
      (ros::load-ros-package pkg)
      (setq cls (eval (read-from-string (format nil "~A::~A" pkg name))))
      (setq msg (instance cls :init))
      (send msg :deserialize (hex->string hex))
      (format t "~%CDR ~A ~A~%" type (string->hex (send msg :serialize)))
      (finish-output *standard-output*))))
(exit 0)
