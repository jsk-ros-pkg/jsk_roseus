<package format="3">
  <name>roseus</name>
  <version>1.7.5</version>
  <description>EusLisp client for ROS Robot Operating System.</description>
  <maintainer email="k-okada@jsk.t.u-tokyo.ac.jp">Kei Okada</maintainer>
  <maintainer email="obinata@jsk.imi.i.u-tokyo.ac.jp">Yoshiki Obinata</maintainer>

  <license>BSD</license>

  <url type="website">http://pr.willowgarage.com/wiki/roseus</url>
  <!-- <url type="bugtracker"></url> -->

  <author email="k-okada@jsk.t.u-tokyo.ac.jp">Kei Okada</author>
  <author email="obinata@jsk.imi.i.u-tokyo.ac.jp">Yoshiki Obinata</author>

  <buildtool_depend condition="$ROS_VERSION == 1">catkin</buildtool_depend>
  <buildtool_depend condition="$ROS_VERSION == 2">ament_cmake_auto</buildtool_depend>
  <buildtool_depend condition="$ROS_VERSION == 2">ament_cmake_gen_version_h</buildtool_depend>
  <buildtool_depend condition="$ROS_VERSION == 2">rosidl_default_generators</buildtool_depend>
  <buildtool_export_depend condition="$ROS_VERSION == 2">rosidl_generator_eus</buildtool_export_depend>
  <buildtool_export_depend condition="$ROS_VERSION == 2">rosidl_cmake</buildtool_export_depend>

  <build_depend>angles</build_depend>
  <build_depend condition="$ROS_VERSION == 1">rosbash</build_depend>
  <build_depend condition="$ROS_VERSION == 1">roslang</build_depend>
  <build_depend condition="$ROS_VERSION == 1">roscpp</build_depend>
  <build_depend condition="$ROS_VERSION == 1">rosnode</build_depend>
  <build_depend condition="$ROS_VERSION == 1">rospack</build_depend>
  <build_depend condition="$ROS_VERSION == 1">rostest</build_depend>
  <build_depend condition="$ROS_VERSION == 1">rosmsg</build_depend>
  <build_depend condition="$ROS_VERSION == 1">rostopic</build_depend>
  <build_depend condition="$ROS_VERSION == 1">mk</build_depend>
  <build_depend condition="$ROS_VERSION == 1">rosbuild</build_depend>
  <build_depend condition="$ROS_VERSION == 1">message_generation</build_depend>
  <build_depend condition="$ROS_VERSION == 1">dynamic_reconfigure</build_depend>
  <build_depend condition="$ROS_VERSION == 1">coreutils</build_depend>

  <exec_depend condition="$ROS_VERSION == 1">rosbash</exec_depend>
  <exec_depend condition="$ROS_VERSION == 1">roslang</exec_depend>
  <exec_depend condition="$ROS_VERSION == 1">roscpp</exec_depend>
  <exec_depend condition="$ROS_VERSION == 1">rosnode</exec_depend>
  <exec_depend condition="$ROS_VERSION == 1">rospack</exec_depend>
  <exec_depend condition="$ROS_VERSION == 1">rostest</exec_depend>
  <exec_depend condition="$ROS_VERSION == 1">rosmsg</exec_depend>
  <exec_depend condition="$ROS_VERSION == 1">message_runtime</exec_depend>
  <exec_depend condition="$ROS_VERSION == 1">dynamic_reconfigure</exec_depend>

  <depend condition="$ROS_VERSION == 1">geneus</depend>
  <depend condition="$ROS_VERSION == 1">euslisp</depend>
  <depend condition="$ROS_VERSION == 1">jskeus</depend>
  <depend condition="$ROS_VERSION == 2">euslisp-dev</depend>
  <depend condition="$ROS_VERSION == 2">jskeus-dev</depend>
  <depend condition="$ROS_VERSION == 1">actionlib</depend>
  <depend condition="$ROS_VERSION == 1">actionlib_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend condition="$ROS_VERSION == 1">tf</depend>
  <depend>tf2_ros</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>sensor_msgs</depend>
  <depend>shape_msgs</depend>
  <depend condition="$ROS_VERSION == 1">actionlib_tutorials</depend>
  <depend condition="$ROS_VERSION == 2">builtin_interfaces</depend>
  <depend condition="$ROS_VERSION == 2">rclcpp</depend>
  <depend condition="$ROS_VERSION == 2">ament_index_cpp</depend>
  <depend condition="$ROS_VERSION == 2">rcpputils</depend>
  <depend condition="$ROS_VERSION == 2">rcl</depend>
  <depend condition="$ROS_VERSION == 2">rmw</depend>
  <depend condition="$ROS_VERSION == 2">rcl_action</depend>
  <depend condition="$ROS_VERSION == 2">rclcpp_action</depend>
  <depend condition="$ROS_VERSION == 2">rosidl_typesupport_cpp</depend>
  <depend condition="$ROS_VERSION == 2">rosidl_typesupport_introspection_cpp</depend>
  <depend condition="$ROS_VERSION == 2">action_msgs</depend>
  <depend condition="$ROS_VERSION == 2">unique_identifier_msgs</depend>

  <exec_depend condition="$ROS_VERSION == 2">rosidl_default_runtime</exec_depend>

  <test_depend>xvfb</test_depend>
  <test_depend condition="$ROS_VERSION == 2">ament_cmake_clang_format</test_depend>
  <test_depend condition="$ROS_VERSION == 2">ament_cmake_ros</test_depend>
  <test_depend condition="$ROS_VERSION == 2">launch</test_depend>
  <test_depend condition="$ROS_VERSION == 2">launch_ros</test_depend>
  <test_depend condition="$ROS_VERSION == 2">launch_testing</test_depend>
  <test_depend condition="$ROS_VERSION == 2">launch_testing_ament_cmake</test_depend>
  <test_depend condition="$ROS_VERSION == 2">control_msgs</test_depend>
  <test_depend condition="$ROS_VERSION == 2">ros2topic</test_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type condition="$ROS_VERSION == 2">ament_cmake</build_type>
  </export>

</package>
