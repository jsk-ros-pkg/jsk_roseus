<launch>
  <arg name="_python_version" default="$(env ROS_PYTHON_VERSION)" />

  <node name="fibonacci_server" pkg="actionlib_tutorials" type="fibonacci_server"/>
  <node name="roseus_smach_samples" pkg="roseus_smach" type="state-machine-ros-sample.l"
        args="(exec-smach-userdata-bool) (exit)" />

  <test test-name="test_unpickle_userdata_python3"
        name="test_unpickle_userdata_python3"
        pkg="jsk_tools" type="test_topic_published.py"
        if="$(eval _python_version == 3)"
        retry="1">
    <rosparam>
      topic_0: /server_name/smach/container_status
      import: ['pickle']
      condition_0: pickle.loads(m.local_data.encode('utf-8'))[&quot;BAR-EXECUTED&quot;]
      timeout_0: 20
    </rosparam>
  </test>

  <test test-name="test_unpickle_userdata_python2"
        name="test_unpickle_userdata_python2"
        pkg="jsk_tools" type="test_topic_published.py"
        unless="$(eval _python_version == 3)"
        retry="1">
    <rosparam>
      topic_0: /server_name/smach/container_status
      import: ['pickle']
      condition_0: pickle.loads(m.local_data)[&quot;BAR-EXECUTED&quot;]
      timeout_0: 20
    </rosparam>
  </test>
</launch>
