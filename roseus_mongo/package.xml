<?xml version="1.0"?>
<package format="3">
  <name>roseus_mongo</name>
  <version>1.7.5</version>
  <description>The roseus_mongo package</description>

  <maintainer email="furushchev@jsk.imi.i.u-tokyo.ac.jp">Yuki Furuta</maintainer>

  <license>BSD</license>

  <author email="furushchev@jsk.imi.i.u-tokyo.ac.jp">Yuki Furuta</author>

  <buildtool_depend condition="$ROS_VERSION == 1">catkin</buildtool_depend>
  <buildtool_depend condition="$ROS_VERSION == 2">ament_cmake</buildtool_depend>
  <buildtool_depend condition="$ROS_VERSION == 2">ros_environment</buildtool_depend>
  <build_depend condition="$ROS_VERSION == 1">mongodb_store</build_depend>
  <build_depend condition="$ROS_VERSION == 1">mongodb_store_msgs</build_depend>
  <build_depend>roseus</build_depend>
  <build_depend condition="$ROS_VERSION == 1">rostest</build_depend>
  <exec_depend condition="$ROS_VERSION == 1">mongodb_store</exec_depend>
  <exec_depend condition="$ROS_VERSION == 1">mongodb_store_msgs</exec_depend>
  <exec_depend>roseus</exec_depend>
  <!-- ROS 2: mongodb_store (ROS 2) is required at runtime, it is not released yet -->
  <test_depend condition="$ROS_VERSION == 2">ament_cmake_pytest</test_depend>
  <test_depend condition="$ROS_VERSION == 2">geometry_msgs</test_depend>
  <test_depend condition="$ROS_VERSION == 2">std_srvs</test_depend>
  <test_depend condition="$ROS_VERSION == 2">rclpy</test_depend>
  <export>
    <build_type condition="$ROS_VERSION == 1">catkin</build_type>
    <build_type condition="$ROS_VERSION == 2">ament_cmake</build_type>
  </export>
</package>
