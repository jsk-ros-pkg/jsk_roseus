#!/usr/bin/env python3

import argparse
import os
import sys

try:
    from rosidl_generator_eus import generate_eus
except ImportError:
    rosidl_generator_eus_root = os.path.dirname(os.path.dirname(__file__))
    rosidl_generator_eus_module = os.path.join(
        rosidl_generator_eus_root, 'rosidl_generator_eus', '__init__.py')
    if not os.path.exists(rosidl_generator_eus_module):
        raise
    from importlib.machinery import SourceFileLoader

    loader = SourceFileLoader(
        'rosidl_generator_eus', rosidl_generator_eus_module)
    rosidl_generator_eus = loader.load_module()
    generate_eus = rosidl_generator_eus.generate_eus


def main(argv=sys.argv[1:]):
    parser = argparse.ArgumentParser(
        description='Generate the EusLisp ROS interfaces.')
    parser.add_argument(
        '--generator-arguments-file',
        required=True,
        help='The location of the file containing the generator arguments')
    args = parser.parse_args(argv)

    generate_eus(args.generator_arguments_file)
    return 0


if __name__ == '__main__':
    sys.exit(main())
