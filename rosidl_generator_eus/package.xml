<?xml version="1.0"?>
<package format="3">
  <name>rosidl_generator_eus</name>
  <version>1.7.5</version>
  <description>
    Generate the EusLisp (roseus) message classes of ROS 2 interfaces.
    When this package is installed, every interface package built after it
    installs its euslisp messages in share/roseus/ros/PKG. The messages of
    the other packages are generated by roseus on demand.
  </description>
  <maintainer email="k-okada@jsk.t.u-tokyo.ac.jp">Kei Okada</maintainer>
  <license>BSD</license>
  <author email="k-okada@jsk.t.u-tokyo.ac.jp">Kei Okada</author>

  <buildtool_depend condition="$ROS_VERSION == 1">catkin</buildtool_depend>
  <buildtool_depend condition="$ROS_VERSION == 2">ament_cmake</buildtool_depend>
  <buildtool_depend condition="$ROS_VERSION == 2">ros_environment</buildtool_depend>

  <buildtool_export_depend condition="$ROS_VERSION == 2">rosidl_cmake</buildtool_export_depend>
  <exec_depend condition="$ROS_VERSION == 2">rosidl_adapter</exec_depend>
  <exec_depend condition="$ROS_VERSION == 2">ament_index_python</exec_depend>
  <exec_depend condition="$ROS_VERSION == 2">python3</exec_depend>

  <member_of_group condition="$ROS_VERSION == 2">rosidl_generator_packages</member_of_group>

  <export>
    <build_type condition="$ROS_VERSION == 1">catkin</build_type>
    <build_type condition="$ROS_VERSION == 2">ament_cmake</build_type>
  </export>
</package>
