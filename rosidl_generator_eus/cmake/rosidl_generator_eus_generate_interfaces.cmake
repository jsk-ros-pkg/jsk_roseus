# Generate the euslisp messages of the interfaces of ${PROJECT_NAME}, run
# by rosidl_generate_interfaces() (it is a macro, so _non_idl_tuples, the
# .msg/.srv/.action files given to it, is visible here). The messages are
# installed in share/roseus/ros/${PROJECT_NAME}, where roseus finds them.

set(_eus_output_dir "${CMAKE_CURRENT_BINARY_DIR}/rosidl_generator_eus")
set(_eus_files "")
foreach(_tuple ${_non_idl_tuples})
  string(REGEX REPLACE ":([^:]*)$" "/\\1" _file "${_tuple}")
  list(APPEND _eus_files "${_file}")
endforeach()

if(_eus_files)
  find_package(Python3 REQUIRED COMPONENTS Interpreter)
  set(_eus_outputs "")
  foreach(_file ${_eus_files})
    get_filename_component(_parent "${_file}" DIRECTORY)
    get_filename_component(_sub "${_parent}" NAME)
    get_filename_component(_name "${_file}" NAME_WE)
    list(APPEND _eus_outputs "${_eus_output_dir}/${PROJECT_NAME}/${_sub}/${_name}.l")
  endforeach()
  # the type hashes (RIHS) are generated by rosidl_generator_type_description
  set(_eus_share "${CMAKE_CURRENT_BINARY_DIR}/rosidl_generator_type_description/${PROJECT_NAME}")
  add_custom_command(
    OUTPUT ${_eus_outputs}
    COMMAND ${Python3_EXECUTABLE} ${rosidl_generator_eus_BIN}
      -o ${_eus_output_dir}
      --share ${PROJECT_NAME}:${_eus_share}
      --files ${_eus_files}
      -- ${PROJECT_NAME}
    DEPENDS ${_eus_files} ${rosidl_generator_eus_BIN}
    COMMENT "Generating euslisp messages of ${PROJECT_NAME}"
    VERBATIM)
  add_custom_target(${rosidl_generate_interfaces_TARGET}__eus ALL
    DEPENDS ${_eus_outputs})
  if(TARGET ${rosidl_generate_interfaces_TARGET}__rosidl_generator_type_description)
    add_dependencies(${rosidl_generate_interfaces_TARGET}__eus
      ${rosidl_generate_interfaces_TARGET}__rosidl_generator_type_description)
  endif()
  add_dependencies(${rosidl_generate_interfaces_TARGET} ${rosidl_generate_interfaces_TARGET}__eus)
  if(NOT rosidl_generate_interfaces_SKIP_INSTALL)
    install(DIRECTORY "${_eus_output_dir}/${PROJECT_NAME}/"
      DESTINATION "share/roseus/ros/${PROJECT_NAME}")
  endif()
endif()
