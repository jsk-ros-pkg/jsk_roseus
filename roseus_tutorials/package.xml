<package format="3">
  <name>roseus_tutorials</name>
  <version>1.7.5</version>
  <description>roseus_tutorials
 </description>

  <maintainer email="k-okada@jsk.t.u-tokyo.ac.jp">Kei Okada</maintainer>

  <license>BSD</license>

  <url type="website">http://ros.org/wiki/roseus_tutorials</url>
  <!-- <url type="bugtracker"></url> -->

  <author>Manabu Saito</author>
  <author>Tsukasa Ito</author>
  <author>Kei Okada</author>
  <author>Yoshiki Obinata</author>

  <buildtool_depend condition="$ROS_VERSION == 1">catkin</buildtool_depend>
  <buildtool_depend condition="$ROS_VERSION == 2">ament_cmake_auto</buildtool_depend>

  <depend>roseus</depend>
  <depend condition="$ROS_VERSION == 2">example_interfaces</depend>
  <depend condition="$ROS_VERSION == 2">std_msgs</depend>
  <depend condition="$ROS_VERSION == 2">std_srvs</depend>

  <exec_depend condition="$ROS_VERSION == 1">uvc_camera</exec_depend>
  <exec_depend condition="$ROS_VERSION == 1">ar_track_alvar</exec_depend>
  <exec_depend condition="$ROS_VERSION == 1">opencv_apps</exec_depend>
  <!-- <run_depend>saliency_tracking<run_depend> -->
  <!-- <depend package="cmvision" /> -->
  <!-- <run_depend>checkerboard_pose</run_depend> -->
  <!-- <run_depend>face_detector_mono<run_depend> -->
  <!-- <depend package="aques_talk" /> -->
  <exec_depend condition="$ROS_VERSION == 1">checkerboard_detector</exec_depend>
  <!-- run depends on pr2eus has circular dependencies, so removed from package.xml -->
  <!-- <run_depend>pr2eus</run_depend> -->
  <exec_depend condition="$ROS_VERSION == 1">image_proc</exec_depend>
  <exec_depend condition="$ROS_VERSION == 1">image_view2</exec_depend>
  <exec_depend condition="$ROS_VERSION == 1">posedetection_msgs</exec_depend>
  <!-- <run_depend>jsk_perception</run_depend> -->
  <exec_depend condition="$ROS_VERSION == 1">visualization_msgs</exec_depend>
  <exec_depend condition="$ROS_VERSION == 1">jsk_recognition_msgs</exec_depend>
  <!-- <run_depend>tabletop_object_detector</run_depend> -->

  <test_depend condition="$ROS_VERSION == 1">jsk_pcl_ros</test_depend>
  <test_depend condition="$ROS_VERSION == 1">rostest</test_depend>
  <export>
    <build_type condition="$ROS_VERSION == 2">ament_cmake</build_type>
  </export>
</package>
